    ("¿Cuánto cuesta emitir la tarjeta Clásica?", "SI", "10"),
    ("¿Cuánto me cobran por sacar la Platino?", "SI", "25"),
    ("¿Qué interés anual tiene la Clásica?", "SI", "15,5"),
    ("¿Cuál es la tasa de la tarjeta Black?", "NO", None),
    ("¿Qué requisitos necesito para un préstamo?", "NO", None),
    ("¿La Platino tiene seguro de viaje?", "NO", None),
    ("¿Cuál es el cupo máximo de la Clásica?", "NO", None),
]

ok_decision = ok_dato = 0
for pregunta, esperado, dato in pruebas:
